# Every variable the API reads, with a non-secret sample value.
# Copy to .env for local development. Real secrets come from the platform's secret
# manager in deployed environments and are never committed.

# development | test | production
NODE_ENV=development

# HTTP server. 3100 locally so this base can run beside another project's API on 3000.
# The container never publishes this port to the host: it is reachable only through the
# reverse proxy on an internal network.
HOST=0.0.0.0
PORT=3100

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Whether this process also runs the pg-boss workers. API and workers run in one process
# by default; set to false to boot the same image as an API-only instance.
WORKERS_ENABLED=true

# Request body limit in bytes. Bounds an obvious resource-consumption vector.
BODY_LIMIT_BYTES=1048576

# Comma-separated origin allowlist for browser callers. Never "*" with credentials.
# Empty means no cross-origin caller is permitted.
CORS_ALLOWED_ORIGINS=http://localhost:5273

# How long SIGTERM waits for in-flight requests and jobs to drain.
SHUTDOWN_TIMEOUT_MS=15000

# Postgres connection string for the control plane. No default: booting against the
# wrong database is exactly the failure the config refuses to allow. Local Supabase for
# this project (its own instance, on the 553xx port range):
CONTROL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Host suffix under which tenant subdomains live: acme.example.test
ROOT_DOMAIN=example.test

# Supabase Auth. The anon key is public by design — it identifies the project and is only
# safe because RLS is correct. The service_role key is NOT here: it never belongs in a
# file the API reads at boot.
SUPABASE_AUTH_URL=http://127.0.0.1:55321/auth/v1
# Bypasses RLS completely. Needed only by `pnpm seed:auth` on a local stack; leave it
# unset everywhere else. Read it from `pnpm supabase status`. Never put it in the browser
# bundle, a log, or git.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_ANON_KEY=<pnpm supabase status -o json | jq -r .ANON_KEY>

# Absolute session lifetime. A refresh token older than this stops working.
SESSION_MAX_AGE_SECONDS=43200

# Applied to a new company's schema during provisioning. Must be the same directory the
# CLI uses, or a newly provisioned company gets a different schema from every other one.
# Relative to the working directory of the API process, which is apps/api.
TENANT_MIGRATIONS_DIRECTORY=../../supabase/tenant-migrations
