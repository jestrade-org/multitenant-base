{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "src/**/*.json"]
}
