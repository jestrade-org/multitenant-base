{
  "name": "@multitenant-base/api",
  "version": "0.1.0",
  "private": true,
  "description": "The single deployable Node service: HTTP API, application/domain layers and workers in one process.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "migrate:tenants": "node --env-file-if-exists=../../.env dist/cli/migrateTenants.js",
    "verify:rls": "node --env-file-if-exists=../../.env dist/cli/verifyRls.js",
    "seed:auth": "node --env-file-if-exists=../../.env dist/cli/seedAuthUsers.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@multitenant-base/audit": "workspace:*",
    "@multitenant-base/iam": "workspace:*",
    "@multitenant-base/integrations": "workspace:*",
    "@multitenant-base/shared-kernel": "workspace:*",
    "@multitenant-base/tenancy": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
